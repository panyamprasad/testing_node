//--> 1. Create a Interface and Use It.
interface Employee {
    id: number;
    name: string;
    email: string;
}

function employeeDetails(emp: Employee): void {
    console.log(
        `${emp.id} - ${emp.name} - ${emp.email}`
    );
}
const employee: Employee = {
    id: 1001,
    name: 'Prasad',
    email: 'helloprasad88@gmail.com'
}

employeeDetails(employee);
