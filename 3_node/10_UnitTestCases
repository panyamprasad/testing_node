describe('Testing User Service', async() => {
    let userService;
    let data;

    beforeEach(() => {
        userService = new userService();
        data = {
            fetchData: async() => {}
        };
    });
 
    if('Should get the userDetails', async() => {
        sinon.stub(data, 'fetchData').resolve({
            id:1,
            name: 'prasad'
        });
        const result = await userService.getUser(data, 1);
        expect(result.id).to.equal(1);
    });
    
});